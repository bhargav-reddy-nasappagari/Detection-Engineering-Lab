{
  "detection_name": "ssh_brute_force",
  "description": "Aggregated authentication failure fields used to identify SSH brute force activity from a repeated source IP within a defined time window.",
  "aggregation": {
    "group_by": [
      "source.ip",
      "destination.port",
      "process.name"
    ],
    "time_window": "2m",
    "threshold": {
      "failed_authentication_attempts": 5
    }
  },
  "critical_detection_fields": {
    "source.ip": {
      "value": "192.168.56.101",
      "purpose": "Identifies repeated attacker origin"
    },
    "destination.port": {
      "value": 22,
      "purpose": "Confirms SSH service targeting"
    },
    "process.name": {
      "value": "sshd",
      "purpose": "Identifies SSH daemon handling authentication"
    },
    "event.action": {
      "value": [
        "failed-password",
        "invalid-user",
        "authentication-failure"
      ],
      "purpose": "Core authentication failure indicators"
    },
    "user.name": {
      "value": [
        "root",
        "admin",
        "test"
      ],
      "purpose": "Identifies targeted accounts"
    },
    "event.outcome": {
      "value": "failure",
      "purpose": "Confirms unsuccessful authentication attempts"
    },
    "authentication.method": {
      "value": "password",
      "purpose": "Indicates password-based authentication abuse"
    },
    "log.file.path": {
      "value": "/var/log/auth.log",
      "purpose": "Primary Linux authentication telemetry source"
    },
    "network.transport": {
      "value": "tcp",
      "purpose": "Confirms SSH transport protocol"
    },
    "ssh.protocol": {
      "value": "SSH-2.0",
      "purpose": "Identifies SSH session protocol"
    }
  },
  "behavioral_indicators": {
    "repeated_source_ip": true,
    "rapid_authentication_failures": true,
    "multiple_username_targeting": true,
    "invalid_user_enumeration": true,
    "preauth_disconnect_behavior": true
  },
  "correlation_summary": {
    "total_failed_attempts": 8,
    "unique_targeted_users": 3,
    "source_ip_reuse": true,
    "authentication_failure_rate": "4 attempts/minute"
  },
  "related_logs": [
    "logs/ssh-brute-force/raw_auth_logs.txt",
    "logs/ssh-brute-force/failed_password_logs.txt",
    "logs/ssh-brute-force/pam_auth_failures.txt",
    "logs/ssh-brute-force/disconnect_events_logs.txt"
  ],
  "mitre_attack": {
    "technique_id": "T1110",
    "technique_name": "Brute Force",
    "tactic": "Credential Access"
  },
  "detection_engineering_notes": [
    "Threshold-based detections should account for legitimate user login mistakes",
    "Correlation by source IP improves brute-force identification accuracy",
    "Invalid-user enumeration attempts strengthen malicious confidence scoring",
    "Authentication bursts over short intervals are high-signal indicators"
  ],
  "tags": [
    "ssh",
    "linux",
    "authentication",
    "brute-force",
    "detection-engineering",
    "sigma-validation"
  ]
}

